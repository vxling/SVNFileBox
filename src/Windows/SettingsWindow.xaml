<Window x:Class="SVNFileBox.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E88E5"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto Sync -->
                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="自动同步" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="启用后自动同步文件变更（不可关闭）" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoSyncCheckBox" Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Sync Interval -->
                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="同步周期（分钟）" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="服务器轮询检查的间隔（1-30分钟）" FontSize="11" Foreground="#666" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SyncIntervalSlider" Minimum="1" Maximum="30" Width="200" Value="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SyncIntervalText" Text="1 分钟" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Language -->
                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="语言" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="界面显示语言" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="120" VerticalAlignment="Center">
                            <ComboBoxItem Content="跟随系统" IsSelected="True"/>
                            <ComboBoxItem Content="中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Proxy -->
                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="代理地址" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="HTTP 代理（留空则不使用代理）" FontSize="11" Foreground="#666" Margin="0,2,0,6"/>
                        <TextBox x:Name="ProxyUrlBox" Padding="4,3" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Auto Start -->
                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机启动" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Windows 启动时自动运行" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Minimize to Tray -->
                <Border Background="#F5F5F5" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最小化到托盘" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="关闭窗口时最小化到系统托盘" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Style="{StaticResource DialogButtonStyle}" Margin="0,0,10,0" Click="OK_Click"/>
            <Button Content="取消" Style="{StaticResource DialogButtonStyle}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>