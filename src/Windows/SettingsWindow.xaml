<Window x:Class="SVNFileBox.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto Sync -->
                <ui:Card Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="自动同步" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="启用后自动同步文件变更（不可关闭）" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutoSyncCheckBox" Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- Sync Interval -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="同步周期（分钟）" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="服务器轮询检查的间隔（1-30分钟）" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SyncIntervalSlider" Minimum="1" Maximum="30" Width="200"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SyncIntervalText" Text="1 分钟" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Language -->
                <ui:Card Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="语言" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="界面显示语言" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="120" VerticalAlignment="Center">
                            <ComboBoxItem Content="跟随系统" IsSelected="True"/>
                            <ComboBoxItem Content="中文"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </Grid>
                </ui:Card>

                <!-- Proxy -->
                <ui:Card Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="代理地址" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="HTTP 代理（留空则不使用代理）" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>
                        <ui:TextBox x:Name="ProxyUrlBox" PlaceholderText="http://proxy:port"/>
                    </StackPanel>
                </ui:Card>

                <!-- Auto Start -->
                <ui:Card Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开机启动" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="Windows 启动时自动运行" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>

                <!-- Minimize to Tray -->
                <ui:Card Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="最小化到托盘" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="关闭窗口时最小化到系统托盘" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="MinimizeToTrayCheckBox" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button Content="确定" Appearance="Primary" Margin="0,0,10,0" Click="OK_Click"/>
            <ui:Button Content="取消" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
