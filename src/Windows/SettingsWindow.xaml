<Window x:Class="SVNFileBox.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SettingsTitle}"
        Height="440" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Auto Sync -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource AutoSync}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource AutoSyncTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoSyncCheckBox" Grid.Column="1" IsChecked="True" IsEnabled="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Sync Interval -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SyncInterval}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{DynamicResource SyncIntervalTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="SyncIntervalSlider" Minimum="1" Maximum="10" Width="200" Value="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SyncIntervalText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Theme -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Theme}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource ThemeTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource ThemeSystem}" Grid.Column="1" VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                </Border>

                <!-- Language -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Language}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource LanguageTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="120" VerticalAlignment="Center">
                            <ComboBoxItem Content="{DynamicResource LangSystem}"/>
                            <ComboBoxItem Content="{DynamicResource LangZh}"/>
                            <ComboBoxItem Content="{DynamicResource LangEn}"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- Proxy -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource ProxyUrl}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{DynamicResource ProxyUrlTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,6"/>
                        <TextBox x:Name="ProxyUrlBox" Padding="4,3" FontSize="12"/>
                    </StackPanel>
                </Border>

                <!-- Auto Start -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource AutoStart}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource AutoStartTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheckBox" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Auto Start Minimize -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource AutoStartMinimize}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource AutoStartMinimizeTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartMinimizeCheckBox" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False"/>
                    </Grid>
                </Border>

                <!-- Minimize to Tray -->
                <Border Background="{DynamicResource ThemeBackgroundFillColorDefaultBrush}" Padding="12" Margin="0,0,0,10" CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource MinimizeToTray}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource MinimizeToTrayTip}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="MinimizeToTrayCheckBox" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{DynamicResource OK}" Margin="0,0,10,0" Click="OK_Click" MinWidth="80" Padding="12,6"/>
            <Button Content="{DynamicResource Cancel}" Click="Cancel_Click" MinWidth="80" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
