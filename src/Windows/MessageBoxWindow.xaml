<Window x:Class="SVNFileBox.Windows.MsgBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Height="160" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon (always overwritten by SetIcon before show) -->
        <TextBlock x:Name="IconText" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                   Text="i" FontSize="18" FontWeight="Bold" VerticalAlignment="Top" Margin="0,0,12,0"/>

        <!-- Title -->
        <TextBlock x:Name="TitleText" Grid.Row="0" Grid.Column="1"
                   Text="{Binding Title}"
                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <!-- Message -->
        <TextBlock x:Name="MessageText" Grid.Row="1" Grid.Column="1"
                   Text="{Binding Message}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#444"/>

        <!-- Buttons -->
        <StackPanel x:Name="ButtonsPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Buttons injected dynamically -->
        </StackPanel>
    </Grid>
</Window>
