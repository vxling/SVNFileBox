<Window x:Class="SVNFileBox.Windows.FileCopyProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackBrush}"
        Title="正在复制文件"
        Height="200" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Closing="Window_Closing">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Current file name -->
        <TextBlock x:Name="CurrentFileText"
                   Grid.Row="0"
                   FontSize="13" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, ElementName=CurrentFileText}"
                   Margin="0,0,0,4"/>

        <!-- Current item index -->
        <TextBlock x:Name="ItemIndexText"
                   Grid.Row="1"
                   FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,10"/>

        <!-- Progress bar -->
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="20"
                     Minimum="0" Maximum="100"
                     Margin="0,0,0,6" Style="{DynamicResource Win11ProgressBarStyle}"/>

        <!-- Bytes and time -->
        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BytesText"
                       Grid.Column="0"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="TimeText"
                       Grid.Column="2"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </Grid>

        <!-- Cancel button -->
        <Button x:Name="CancelButton"
                Grid.Row="5"
                Content="取消"
                HorizontalAlignment="Right"
                MinWidth="90" Padding="16,7"                
                Click="Cancel_Click" Style="{DynamicResource Win11NormalButtonStyle}"/>
    </Grid>
</Window>
