<Window x:Class="SVNFileBox.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SVNFileBox"
        Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">
    <Grid Background="#1E88E5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App name and logo area -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="SVNFileBox"
                       FontSize="32" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock x:Name="TaglineText"
                       FontSize="14" Foreground="#BBDEFB"
                       HorizontalAlignment="Center" Margin="0,6,0,0"><Run Language="zh-cn" Text="SVN Based Sync"/></TextBlock>
        </StackPanel>

        <!-- Status messages -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="Initializing..."
                   FontSize="13" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,0,0,12"
                   TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>

        <!-- Progress bar -->
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="4" Margin="40,0,40,0"
                     Minimum="0" Maximum="100" Value="0"
                     Background="#1565C0" Foreground="#BBDEFB"/>

        <!-- Bottom step indicator -->
        <StackPanel Grid.Row="3" Margin="0,12,0,20">
            <TextBlock x:Name="StepText"
                       Text="Step 1 / 3"
                       FontSize="11" Foreground="#90CAF9"
                       HorizontalAlignment="Center" Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
