<Window x:Class="SVNFileBox.Windows.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SVNFileBox"
        Height="280" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- App name and logo area -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="SVNFileBox"
                       FontSize="32" FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="SVN 文件管理器"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Status messages -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Text="正在初始化..."
                   FontSize="13"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,12"
                   TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>

        <!-- Progress bar -->
        <ProgressBar x:Name="ProgressBar"
                     Grid.Row="2"
                     Height="4" Margin="40,0,40,0"
                     Minimum="0" Maximum="100" Value="0"
                     Background="{DynamicResource AccentFillColorDefaultBrush}"/>

        <!-- Bottom step indicator -->
        <StackPanel Grid.Row="3" Margin="0,12,0,20">
            <TextBlock x:Name="StepText"
                       Text="步骤 1 / 4"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
