<Window x:Class="SVNFileBox.Windows.ConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SVNFileBox.Models"
        xmlns:conv="clr-namespace:SVNFileBox.Converters"
        Title="{DynamicResource ConflictTitle}"
        Height="420" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:LocalIsNewerToSuggestionConverter x:Key="LocalIsNewerToSuggestionConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="⚠" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{DynamicResource ConflictTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{DynamicResource ConflictDesc}" TextWrapping="Wrap" Foreground="#666" FontSize="12" Margin="0,0,0,12"/>

        <!-- Conflict list -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlBorderNormalBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ConflictFiles}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:ConflictedFileInfo}">
                            <Border BorderBrush="{DynamicResource ControlBorderNormalBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- File name and times -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{DynamicResource Local}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding LocalModifiedTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="4,0,16,0"/>
                                            <TextBlock Text="{DynamicResource Server}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                                            <TextBlock Text="{Binding ServerModifiedTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Suggestion badge -->
                                    <Border Grid.Column="1" CornerRadius="3" Padding="8,2" VerticalAlignment="Top" Margin="8,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource InfoBackgroundBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LocalIsNewer}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding LocalIsNewer, Converter={StaticResource LocalIsNewerToSuggestionConverter}}"
                                                   FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource InfoForegroundBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LocalIsNewer}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Resolution selector -->
                                    <ComboBox Grid.Column="2" VerticalAlignment="Center"
                                              SelectedValue="{Binding SelectedResolution}"
                                              SelectedValuePath="Tag"
                                              Width="140" Style="{StaticResource Win11ComboBoxStyle}">
                                        <ComboBoxItem Content="{DynamicResource KeepLocal}" Tag="{x:Static local:ConflictResolution.KeepLocal}"/>
                                        <ComboBoxItem Content="{DynamicResource AcceptServer}" Tag="{x:Static local:ConflictResolution.AcceptServer}"/>
                                        <ComboBoxItem Content="{DynamicResource KeepBoth}" Tag="{x:Static local:ConflictResolution.KeepBoth}"/>
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource KeepAllLocal}" Click="KeepAllLocal_Click"
                    Padding="12,6" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="{DynamicResource AcceptAllServer}" Click="AcceptAllServer_Click"
                    Padding="12,6" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="{DynamicResource ConflictConfirm}" Click="OK_Click"
                    Padding="16,6" MinWidth="80" Margin="0,0,8,0"  />
            <Button Content="{DynamicResource Cancel}" Click="Cancel_Click"
                    Padding="16,6" MinWidth="80" />
        </StackPanel>
    </Grid>
</Window>
