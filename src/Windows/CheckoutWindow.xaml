<Window x:Class="SVNFileBox.Windows.CheckoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource CheckoutTitle}" Height="280" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource RepoName}" VerticalAlignment="Center" FontSize="13"/>
        <TextBox x:Name="RepoNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="4,3" FontSize="13"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource RepoUrl}" VerticalAlignment="Center" FontSize="13"/>
        <TextBox x:Name="RepoUrlBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Padding="4,3" FontSize="13"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Username}" VerticalAlignment="Center" FontSize="13"/>
        <TextBox x:Name="UsernameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Padding="4,3" FontSize="13"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Password}" VerticalAlignment="Center" FontSize="13"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Padding="4,3" FontSize="13"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LocalPath}" VerticalAlignment="Center" FontSize="13" Visibility="Collapsed"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LocalPathBox" Grid.Column="0" IsReadOnly="True" Padding="4,3" FontSize="13"/>
            <Button Content="{DynamicResource Browse}" Grid.Column="1" Margin="5,0,0,0" Click="Browse_Click" MinWidth="80" Padding="12,6"/>
        </Grid>

        <TextBlock x:Name="ErrorText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="Red" FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="StatusText" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   FontSize="12" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>

        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkButton" Content="{DynamicResource Confirm}" Margin="0,0,10,0" Click="OK_Click" MinWidth="80" Padding="12,6"/>
            <Button x:Name="CancelButton" Content="{DynamicResource Cancel}" Click="Cancel_Click" MinWidth="80" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
