<Window x:Class="SVNFileBox.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Height="265" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.08" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E88E5"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1565C0"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1565C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20,20,20,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo / Title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="SVNFileBox" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Version info -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,12">
            <TextBlock Text="版本 2.0.0" FontSize="13" HorizontalAlignment="Center" Foreground="#666"/>
            <TextBlock Text="SVN 版 Dropbox" FontSize="12" HorizontalAlignment="Center" Foreground="#888" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Description -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="本地文件夹自动同步到 SVN 仓库，多设备共享。" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="#555"/>
            <TextBlock Text="冲突时以最后修改时间为准自动解决。" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="#555" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Close button -->
        <Button Grid.Row="3" Content="关闭" Style="{StaticResource DialogButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Top" Click="Close_Click" Margin="0,20,0,0"/>
    </Grid>
</Window>