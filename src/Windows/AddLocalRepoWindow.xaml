<Window x:Class="SVNFileBox.Windows.AddLocalRepoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="添加本地仓库" Height="150" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="本地路径:" VerticalAlignment="Center" FontSize="13"/>
        <ui:TextBox x:Name="LocalPathBox" Grid.Row="0" Grid.Column="1" IsReadOnly="True"/>
        <ui:Button Content="浏览..." Grid.Row="0" Grid.Column="2" Margin="5,0,0,0" Click="Browse_Click"/>

        <TextBlock x:Name="ErrorText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <TextBlock x:Name="StatusText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <ui:Button x:Name="OkButton" Content="确认" Appearance="Primary" Margin="0,0,10,0" Click="OK_Click"/>
            <ui:Button x:Name="CancelButton" Content="取消" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
