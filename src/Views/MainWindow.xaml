        <BitmapImage x:Key="MenuIconExplorerImg" UriSource="pack://application:,,,/Assets/Icons/OpenInExplorer.png"/>
        <BitmapImage x:Key="NewFolderImg" UriSource="pack://application:,,,/Assets/Icons/dir.png"/>
        <!-- Menu Icons using PNG images via DrawingImage + ImageBrush wrapper -->
        <BitmapImage x:Key="MenuIconNewFolderImg" UriSource="pack://application:,,,/Assets/Icons/MenuIconNewFolder.png"/>
        <BitmapImage x:Key="MenuIconNewImg" UriSource="pack://application:,,,/Assets/Icons/MenuIconNew.png"/>
        <BitmapImage x:Key="NetworkRepoImg" UriSource="pack://application:,,,/Assets/Icons/NetworkRepo.png"/>
