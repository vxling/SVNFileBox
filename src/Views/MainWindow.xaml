<Window x:Class="SVNFileBox.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SVNFileBox.ViewModels"
        xmlns:conv="clr-namespace:SVNFileBox.Converters"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:SVNFileBox.Views"
        mc:Ignorable="d"
        Title="SVNFileBox" Height="580" Width="1100"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icons/app.ico"
        Background="#F0F4F8">

    <Window.Resources>
        <conv:FileTypeIconConverter x:Key="FileTypeIconConverter"/>
        <conv:SvnStatusToColorConverter x:Key="SvnStatusToColorConverter"/>
        <conv:SvnStatusToTextConverter x:Key="SvnStatusToTextConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibleConverter"/>
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsedConverter"/>

        <!-- Repository Icons -->
        <DrawingImage x:Key="LocalRepoIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFA000">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 2,4 L 2,16 L 16,16 L 16,6 L 7,6 L 5,3 L 2,3 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFC107">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 1,8 L 1,17 L 17,17 L 17,8 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="NetworkRepoIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#42A5F5">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 4,16 L 14,16 L 14,13 L 11,13 A 3.5,3.5 0 1 1 8,9.5 A 4,4 0 1 1 4,13 L 4,16 Z"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Context Menu for file list -->
        <ContextMenu x:Key="FileContextMenu" Opened="ContextMenu_Opened">
            <MenuItem Header="在资源管理器中打开" Click="OpenInExplorer_Click" IsEnabled="{Binding CanDelete}" Icon="📂"/>
            <Separator/>
            <MenuItem Header="复制路径" Click="CopyPath_Click" IsEnabled="{Binding CanDelete}" Icon="📋"/>
            <Separator/>
            <MenuItem Header="粘贴" Click="Paste_Click" x:Name="PasteMenuItem" Icon="📄"/>
            <MenuItem Header="新建文件夹" Click="NewFolder_Click" IsEnabled="{Binding CanOperate}" Icon="📁"/>
            <MenuItem Header="重命名" Click="Rename_Click" IsEnabled="{Binding CanRename}" Icon="✏️"/>
            <Separator/>
            <MenuItem Header="删除" Click="Delete_Click" IsEnabled="{Binding CanDelete}" Icon="🗑️"/>
            <Separator/>
            <MenuItem Header="刷新" Click="Refresh_Click" IsEnabled="{Binding CanOperate}" Icon="🔄"/>
            <Separator/>
            <MenuItem Header="手工同步" Click="ManualSync_Click" IsEnabled="{Binding CanOperate}" Icon="🔃"/>
        </ContextMenu>
    </Window.Resources>

    <DockPanel>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="/Assets/Icons/app.ico"
                        ToolTipText="SVNFileBox"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开 SVNFileBox" Click="TrayShow_Click"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#1E88E5" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentPathText" Grid.Column="0" Text="" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="" Foreground="White" FontSize="12" VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="White" Margin="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="仓库列表" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                        <Separator Margin="0,0,0,8"/>
                        <Button x:Name="AddLocalRepoButton" Content="📂 添加本地仓库" Click="AddLocalRepo_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                        <Button x:Name="CheckoutButton" Content="🌐 从网络添加仓库" Click="Checkout_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                        <Button x:Name="ViewSyncRecordsButton" Content="📋 查看同步记录" Click="ViewSyncRecords_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                        <Separator Margin="0,4"/>
                        <Button x:Name="SettingsButton" Content="⚙️ 设置" Click="Settings_Click" Margin="0,0,0,8" HorizontalContentAlignment="Left"/>
                        <Button x:Name="AboutButton" Content="ℹ️ 关于" Click="About_Click" HorizontalContentAlignment="Left"/>
                    </StackPanel>

                    <ListBox x:Name="RepoList" ItemsSource="{Binding Repositories}" SelectedItem="{Binding SelectedRepository, Mode=TwoWay}" Background="Transparent" BorderThickness="0" SelectionChanged="RepoList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Tag="{Binding}" Content="X" Padding="4,2"
                                            Background="Transparent" Foreground="#E53935" FontSize="11"
                                            BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Margin="4,0,0,0"
                                            Click="RemoveRepo_Click"/>
                                    <Image DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,10,0">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Stretch" Value="Uniform"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RepositoryType}" Value="Local">
                                                        <Setter Property="Source" Value="{StaticResource LocalRepoIcon}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RepositoryType}" Value="Network">
                                                        <Setter Property="Source" Value="{StaticResource NetworkRepoIcon}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13"/>
                                        <TextBlock Text="{Binding Path}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Area: File Browser / Sync Records -->
            <Border Grid.Column="1" Background="White" Margin="0,8,8,8">
                <DockPanel>
                    <!-- Path Bar -->
                    <Border DockPanel.Dock="Top" Background="#FAFBFC" Padding="12,10" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="路径:" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock x:Name="PathText" Text="" FontSize="13"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="RefreshListButton" Content="刷新" Click="Refresh_Click" Padding="12,6"/>
                        </Grid>
                    </Border>

                    <!-- File List with columns -->
                    <ListView x:Name="FileList"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectedItem="{Binding SelectedFile}"
                              ContextMenu="{StaticResource FileContextMenu}"
                              MouseDoubleClick="FileList_MouseDoubleClick"
                              AllowDrop="True"
                              Drop="FileList_Drop"
                              DragOver="FileList_DragOver"
                              Visibility="{Binding ShowSyncRecords, Converter={StaticResource BoolToCollapsedConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="类型" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding Converter={StaticResource FileTypeIconConverter}}" Width="24" Height="24"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="名称" Width="280" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="状态" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding SvnStatus, Converter={StaticResource SvnStatusToColorConverter}}"
                                                    CornerRadius="9" Padding="2,0" HorizontalAlignment="Center"
                                                    Width="18" Height="18">
                                                <TextBlock Text="{Binding SvnStatus, Converter={StaticResource SvnStatusToTextConverter}}"
                                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding FileSizeDisplay}"/>
                                <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding LastModifiedDisplay}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Sync Records List -->
                    <ListView x:Name="SyncRecordList"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{Binding SyncRecords}"
                              Visibility="{Binding ShowSyncRecords, Converter={StaticResource BoolToVisibleConverter}}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="时间" Width="150" DisplayMemberBinding="{Binding TimestampDisplay}"/>
                                <GridViewColumn Header="仓库" Width="100" DisplayMemberBinding="{Binding RepoName}"/>
                                <GridViewColumn Header="文件" Width="280" DisplayMemberBinding="{Binding FilePath}"/>
                                <GridViewColumn Header="操作" Width="100" DisplayMemberBinding="{Binding OperationDisplay}"/>
                                <GridViewColumn Header="结果" Width="80" DisplayMemberBinding="{Binding ResultDisplay}"/>
                                <GridViewColumn Header="详情" Width="200" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
