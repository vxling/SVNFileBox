        <BitmapImage x:Key="MenuIconNewPowerPointImg" UriSource="pack://application:,,,/Assets/Icons/MenuIconNewPowerPoint.png"/>
        <BitmapImage x:Key="MenuIconNewBmpImageImg" UriSource="pack://application:,,,/Assets/Icons/MenuIconNewBmpImage.png"/>
        <BitmapImage x:Key="MenuIconNewPngImageImg" UriSource="pack://application:,,,/Assets/Icons/MenuIconNewPngImage.png"/>
