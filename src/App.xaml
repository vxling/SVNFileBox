<Application x:Class="SVNFileBox.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             DispatcherUnhandledException="Application_DispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 自定义 Win11 主题（无 Fluent，避免 GridViewColumnHeader 被隐式样式覆盖） -->
                <ResourceDictionary Source="pack://application:,,,/SVNFileBox;component/Themes/Win11DarkTheme.xaml"/>
                <!-- 语言资源（运行时由 LocalizationService 动态替换） -->
                <ResourceDictionary x:Name="LangResources"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
