<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 文件列表浅色主题 - 对应 Windows 11 浅色模式 -->

    <!-- 普通行 -->
    <SolidColorBrush x:Key="FileRowBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FileRowHoverBg" Color="#E5EFFB"/>
    <SolidColorBrush x:Key="FileRowHoverBorder" Color="#C6D8F0"/>

    <!-- 选中行（无焦点） -->
    <SolidColorBrush x:Key="FileRowSelectedBg" Color="#E5EFFB"/>
    <SolidColorBrush x:Key="FileRowSelectedBorder" Color="#C6D8F0"/>
    <SolidColorBrush x:Key="FileRowSelectedText" Color="#000000"/>

    <!-- 选中行（有焦点） -->
    <SolidColorBrush x:Key="FileRowSelectedFocusedBorder" Color="#000000"/>

    <!-- 表头 -->
    <SolidColorBrush x:Key="FileListHeaderBg" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="FileListHeaderBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="FileListHeaderText" Color="#1A1A1A"/>

    <!-- 普通文本 -->
    <SolidColorBrush x:Key="FileRowText" Color="#000000"/>
    <SolidColorBrush x:Key="FileRowSecondaryText" Color="#666666"/>

    <!-- 分隔线 -->
    <SolidColorBrush x:Key="FileRowSeparator" Color="#E0E0E0"/>

</ResourceDictionary>
